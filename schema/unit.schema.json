{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content.entrapprendre.invalid/schema/unit-v1.json",
  "title": "Unité Entr'Apprendre",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "moduleId",
    "number",
    "title",
    "status",
    "estimatedMinutes",
    "objectives",
    "blocks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "moduleId": { "$ref": "#/$defs/identifier" },
    "number": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "#/$defs/nonEmptyText" },
    "status": { "enum": ["draft", "review", "published"] },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyText" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lessonBlock" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "blockIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "nonEmptyText": { "type": "string", "minLength": 1 },
    "audioTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^media/[^?#]+\\.(mp3|wav|m4a|ogg|aac|flac|opus)$"
        },
        "transcript": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "audio": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^media/[^?#]+\\.(mp3|wav|m4a|ogg|aac|flac|opus)$"
            },
            "transcript": { "$ref": "#/$defs/nonEmptyText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tracks"],
          "properties": {
            "tracks": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "fr": { "$ref": "#/$defs/audioTrack" },
                "ha": { "$ref": "#/$defs/audioTrack" },
                "dje": { "$ref": "#/$defs/audioTrack" }
              }
            }
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "alt"],
      "properties": {
        "path": {
          "description": "Chemin relatif dans le dossier de l'unité, ex. media/atelier.jpg. tool/build_release.dart le réécrit en URL de release immuable.",
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "description": "Description de l'image pour qui ne la voit pas. Obligatoire : une image sans texte de remplacement ne dit rien à l'apprenant qui écoute.",
          "$ref": "#/$defs/nonEmptyText"
        }
      }
    },
    "common": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "type": "string" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" }
      }
    },
    "textBlock": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "body"],
          "properties": {
            "id": { "$ref": "#/$defs/blockIdentifier" },
            "kind": { "const": "text" },
            "title": { "$ref": "#/$defs/nonEmptyText" },
            "label": { "$ref": "#/$defs/nonEmptyText" },
            "audio": { "$ref": "#/$defs/audio" },
            "body": { "$ref": "#/$defs/nonEmptyText" }
          }
        }
      ]
    },
    "accordionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "accordion" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" },
        "intro": { "$ref": "#/$defs/nonEmptyText" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": { "$ref": "#/$defs/nonEmptyText" },
              "body": { "$ref": "#/$defs/nonEmptyText" }
            }
          }
        }
      }
    },
    "flashcardsBlock": {
      "description": "Cartes recto-verso. title porte le recto, body le verso — même paire que l'accordéon, parce que le lecteur reçoit les deux types dans la même liste items de BlocUnite.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "flashcards" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": { "$ref": "#/$defs/nonEmptyText" },
              "body": { "$ref": "#/$defs/nonEmptyText" }
            }
          }
        }
      }
    },
    "tabsBlock": {
      "description": "Onglets. title porte le libellé de l'onglet, body son contenu. Les libellés doivent être distincts : le lecteur repère l'onglet actif par son libellé, faute de pouvoir comparer un index dans une condition FlutterFlow.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "tabs" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": { "$ref": "#/$defs/nonEmptyText" },
              "body": { "$ref": "#/$defs/nonEmptyText" }
            }
          }
        }
      }
    },
    "statementBlock": {
      "description": "Idée forte mise en évidence. label porte l'étiquette (« IDÉE FORTE »), body l'énoncé.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "statement" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "body": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" }
      }
    },
    "quoteBlock": {
      "description": "Citation. body porte les mots cités, label la personne citée.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "body", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "quote" },
        "body": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" }
      }
    },
    "listBlock": {
      "description": "Liste numérotée. Chaque élément ne porte que body : le numéro est calculé à l'affichage.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "list" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["body"],
            "properties": { "body": { "$ref": "#/$defs/nonEmptyText" } }
          }
        }
      }
    },
    "imageBlock": {
      "description": "Image avec légende. body porte la légende ; le texte de remplacement vit dans image.alt.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "image"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "image" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "body": { "$ref": "#/$defs/nonEmptyText" },
        "image": { "$ref": "#/$defs/image" },
        "audio": { "$ref": "#/$defs/audio" }
      }
    },
    "processBlock": {
      "description": "Étapes balayables. Une étape par élément, numérotée à l'affichage.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "process" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": { "$ref": "#/$defs/nonEmptyText" },
              "body": { "$ref": "#/$defs/nonEmptyText" }
            }
          }
        }
      }
    },
    "timelineBlock": {
      "description": "Chronologie. label porte le repère (« Jour 1 »), puis title et body.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "timeline" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "title", "body"],
            "properties": {
              "label": { "$ref": "#/$defs/nonEmptyText" },
              "title": { "$ref": "#/$defs/nonEmptyText" },
              "body": { "$ref": "#/$defs/nonEmptyText" }
            }
          }
        }
      }
    },
    "trueFalseBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "answer",
        "feedbackTrue",
        "feedbackFalse"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "truefalse" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" },
        "statement": { "$ref": "#/$defs/nonEmptyText" },
        "answer": { "type": "boolean" },
        "feedbackTrue": { "$ref": "#/$defs/nonEmptyText" },
        "feedbackFalse": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "choiceShape": {
      "type": "object",
      "required": ["prompt", "options"],
      "properties": {
        "prompt": { "$ref": "#/$defs/nonEmptyText" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "feedback"],
            "properties": {
              "id": { "$ref": "#/$defs/blockIdentifier" },
              "text": { "$ref": "#/$defs/nonEmptyText" },
              "feedback": { "$ref": "#/$defs/nonEmptyText" }
            }
          }
        },
        "expectedOptionId": { "$ref": "#/$defs/blockIdentifier" }
      }
    },
    "choiceBlock": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "$ref": "#/$defs/choiceShape" },
        { "properties": { "kind": { "const": "choice" } } }
      ]
    },
    "clozeShape": {
      "type": "object",
      "required": ["text", "gaps"],
      "properties": {
        "text": { "$ref": "#/$defs/nonEmptyText" },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "acceptedAnswers"],
            "properties": {
              "id": { "$ref": "#/$defs/blockIdentifier" },
              "acceptedAnswers": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/nonEmptyText" }
              }
            }
          }
        },
        "feedback": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "clozeBlock": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "$ref": "#/$defs/clozeShape" },
        { "properties": { "kind": { "const": "cloze" } } }
      ]
    },
    "takeawayBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "takeaway" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" },
        "body": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "textareaExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "textarea" },
        "prompt": { "$ref": "#/$defs/nonEmptyText" },
        "hint": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "scaleExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "group", "options", "questions"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "scale" },
        "group": { "$ref": "#/$defs/nonEmptyText" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/nonEmptyText" },
          "uniqueItems": true
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/blockIdentifier" },
              "text": { "$ref": "#/$defs/nonEmptyText" }
            }
          }
        }
      }
    },
    "choiceExercise": {
      "allOf": [
        {
          "type": "object",
          "required": ["id", "kind"],
          "properties": {
            "id": { "$ref": "#/$defs/blockIdentifier" },
            "kind": { "const": "choice" }
          }
        },
        { "$ref": "#/$defs/choiceShape" }
      ]
    },
    "clozeExercise": {
      "allOf": [
        {
          "type": "object",
          "required": ["id", "kind"],
          "properties": {
            "id": { "$ref": "#/$defs/blockIdentifier" },
            "kind": { "const": "cloze" }
          }
        },
        { "$ref": "#/$defs/clozeShape" }
      ]
    },
    "tableExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "columns", "rows", "addRows"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "table" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyText" }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cells"],
            "properties": {
              "cells": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "addRows": { "type": "boolean" }
      }
    },
    "journalExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "moods", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "journal" },
        "moods": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/blockIdentifier" },
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/blockIdentifier" },
              "label": { "$ref": "#/$defs/nonEmptyText" }
            }
          }
        }
      }
    },
    "fieldworkExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "instructions", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "fieldwork" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "instructions": { "$ref": "#/$defs/nonEmptyText" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/blockIdentifier" },
              "label": { "$ref": "#/$defs/nonEmptyText" }
            }
          }
        }
      }
    },
    "exerciseBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/blockIdentifier" },
        "kind": { "const": "exercise" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "audio": { "$ref": "#/$defs/audio" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/textareaExercise" },
              { "$ref": "#/$defs/scaleExercise" },
              { "$ref": "#/$defs/choiceExercise" },
              { "$ref": "#/$defs/clozeExercise" },
              { "$ref": "#/$defs/tableExercise" },
              { "$ref": "#/$defs/journalExercise" },
              { "$ref": "#/$defs/fieldworkExercise" }
            ]
          }
        }
      }
    },
    "lessonBlock": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/accordionBlock" },
        { "$ref": "#/$defs/flashcardsBlock" },
        { "$ref": "#/$defs/tabsBlock" },
        { "$ref": "#/$defs/statementBlock" },
        { "$ref": "#/$defs/quoteBlock" },
        { "$ref": "#/$defs/listBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/processBlock" },
        { "$ref": "#/$defs/timelineBlock" },
        { "$ref": "#/$defs/trueFalseBlock" },
        { "$ref": "#/$defs/choiceBlock" },
        { "$ref": "#/$defs/clozeBlock" },
        { "$ref": "#/$defs/exerciseBlock" },
        { "$ref": "#/$defs/takeawayBlock" }
      ]
    }
  }
}
